Options -Indexes
DirectoryIndex index.php

RewriteEngine On

# Protect application/source folders when the project lives under htdocs/www.
RewriteRule ^(?:app|config|database)(?:/|$) - [F,L,NC]
RewriteRule ^(?:\.env|README\.md)(?:$|/) - [F,L,NC]

# Expose only public static files through the project root.
RewriteRule ^assets/(.*)$ public/assets/$1 [L,NC]
RewriteRule ^uploads/(.*)$ public/uploads/$1 [L,NC]

# Route application requests to the MVC front controller.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]
