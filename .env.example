APP_NAME="Stock Aging Dashboard"
APP_BASE_URL=
APP_TIMEZONE=Asia/Karachi
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=store_aging
DB_USER=root
DB_PASS=

# Encryption keys for stored SMTP / SAP credentials (64 hex chars each).
# Generate: php -r "echo bin2hex(random_bytes(32));"
# When set, these override config/mail_secret.php and config/sap_secret.php.
MAIL_SECRET_KEY=
SAP_SECRET_KEY=

# Minutes of inactivity before a signed-in session expires (default 30).
SESSION_IDLE_MINUTES=30
